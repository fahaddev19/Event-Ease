<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-3">
        <h5 class="card-title mb-0 fw-semibold">
            <i class="bi bi-people-fill me-2"></i>Attendance Tracker
        </h5>
        <span class="badge bg-success fs-6 rounded-pill">
            Total Attendees: @(RegisteredUsers?.Count ?? 0)
        </span>
    </div>
    <div class="card-body p-3">
        @if (RegisteredUsers == null || !RegisteredUsers.Any())
        {
            <div class="text-center py-4 text-muted">
                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                <p class="mb-0">No attendees registered yet. Fill out the registration form to join!</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" style="width: 60px;">#</th>
                            <th scope="col">Attendee Name</th>
                            <th scope="col" class="text-end">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < RegisteredUsers.Count; i++)
                        {
                            var index = i + 1;
                            var attendee = RegisteredUsers[i];
                            <tr>
                                <th scope="row">@index</th>
                                <td class="fw-medium text-dark">
                                    <span class="avatar-circle me-2 bg-primary text-white d-inline-flex justify-content-center align-items-center rounded-circle" style="width: 28px; height: 28px; font-size: 0.8rem;">
                                        @(string.IsNullOrEmpty(attendee) ? "?" : attendee[0].ToString().ToUpper())
                                    </span>
                                    @attendee
                                </td>
                                <td class="text-end">
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                                        Confirmed
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public List<string> RegisteredUsers { get; set; } = new();
}
