@using EventEase.Models

<div class="card h-100 shadow-sm border-0 event-card">
    <div class="card-body d-flex flex-column">
        @if (Event != null)
        {
            <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                    Event #@Event.Id
                </span>
                <span class="text-muted small">
                    <i class="bi bi-calendar-event me-1"></i>@Event.Date.ToString("MMM dd, yyyy • hh:mm tt")
                </span>
            </div>

            <h5 class="card-title fw-bold text-dark mt-1 mb-2">@Event.Title</h5>

            <p class="text-secondary small mb-2">
                <i class="bi bi-geo-alt-fill text-danger me-1"></i><strong>Location:</strong> @Event.Location
            </p>

            <p class="card-text text-muted flex-grow-1">
                @Event.Description
            </p>

            <hr class="my-3 text-secondary" />

            <!-- Checkbox with Two-Way Data Binding (@bind) -->
            <!-- @onclick:stopPropagation="true" prevents navigating when clicked inside an anchor tag -->
            <div class="form-check" @onclick:stopPropagation="true">
                <input type="checkbox"
                       class="form-check-input"
                       id="@($"interested-{Event.Id}")"
                       @bind="isInterested" />
                <label class="form-check-label fw-semibold" for="@($"interested-{Event.Id}")">
                    Mark as Interested
                </label>
            </div>

            <!-- Conditional Confirmation Message -->
            @if (isInterested)
            {
                <div class="alert alert-success d-flex align-items-center mt-2 py-2 px-3 mb-0" role="alert">
                    <span class="me-2">&#10004;</span>
                    <div>
                        <strong>Interested!</strong> We've saved this event to your radar.
                    </div>
                </div>
            }
        }
        else
        {
            <div class="text-muted">No event details provided.</div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public EventModel Event { get; set; } = default!;

    // Two-way bound state for "Mark as Interested" checkbox
    private bool isInterested;
}
